---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionPage from '../../../components/SectionPage.astro';
import { ui } from '../../../i18n/ui.js';

export function getStaticPaths() {
  return [{ params: { locale: 'es' } }, { params: { locale: 'fr' } }, { params: { locale: 'zh' } }];
}

const { locale } = Astro.params;
const t = ui[locale] ?? ui.en;
---

<BaseLayout locale={locale} title={t.basicsTitle} description={t.basicsDesc}>
  <SectionPage locale={locale} section="basics" />
</BaseLayout>
