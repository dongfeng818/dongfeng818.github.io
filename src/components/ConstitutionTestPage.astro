---
// 中医体质测试页 —— 服务端渲染静态框架，答题交互由客户端 JS 完成
import { ui, prefix } from '../i18n/ui.js';
import { constitutionQuestions, constitutionTypes, CONSTITUTION_RULES } from '../data/constitution.js';

const { locale = 'en' } = Astro.props;
const t = ui[locale] ?? ui.en;
const p = prefix(locale);

// 序列化为当前语言的轻量数据，注入客户端脚本
const payload = JSON.stringify({
  questions: constitutionQuestions.map((q) => ({ t: q.t, text: q.q[locale] ?? q.q.en })),
  types: Object.fromEntries(
    Object.entries(constitutionTypes).map(([k, v]) => [
      k,
      {
        glyph: v.glyph,
        pinyin: v.pinyin,
        name: v.name[locale] ?? v.name.en,
        tagline: v.tagline[locale] ?? v.tagline.en,
        desc: v.desc[locale] ?? v.desc.en,
        traits: v.traits[locale] ?? v.traits.en,
        advice: v.advice[locale] ?? v.advice.en,
      },
    ])
  ),
  strings: {
    start: t.testStart,
    prev: t.testPrev,
    next: t.testNext,
    submit: t.testSubmit,
    page: t.testPage,
    of: t.testOf,
    results: t.testResultsTitle,
    mainType: t.testMainType,
    tendency: t.testTendency,
    balancedYes: t.testBalancedYes,
    balancedMostly: t.testBalancedMostly,
    score: t.testScore,
    verdictYes: t.testVerdictYes,
    verdictTendency: t.testVerdictTendency,
    allScores: t.testAllScores,
    traitsLabel: t.traitsLabel,
    adviceLabel: t.adviceLabel,
    retake: t.testRetake,
    disclaimer: t.testDisclaimer,
    options: [t.optNever, t.optRarely, t.optSometimes, t.optOften, t.optAlways],
  },
  rules: CONSTITUTION_RULES,
});
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{t.tagline}</p>
      <h1>{t.testTitle}</h1>
      <p>{t.testLead}</p>
      <p style="font-size: 0.85rem; color: var(--ink-soft);">{t.testMeta} · {t.testNote}</p>
    </div>
    <div id="quiz-app"></div>
  </div>
</section>

<style is:global>
  #quiz-app {
    max-width: 760px;
    margin: 0 auto;
  }
  .qz-card {
    background: linear-gradient(180deg, #ffffff, #fdfcf9);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 1px 2px rgba(28, 38, 34, 0.04), 0 12px 32px -12px rgba(28, 38, 34, 0.1);
  }
  @media (max-width: 640px) {
    .qz-card { padding: 24px 20px; }
  }
  .qz-progress {
    height: 8px;
    background: var(--paper-deep, #f1f0ea);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .qz-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--cinnabar), #3e8e76);
    border-radius: 999px;
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .qz-progress-label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
  }
  .qz-q {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .qz-q:last-of-type {
    border-bottom: none;
    padding-bottom: 8px;
  }
  .qz-q-title {
    font-weight: 600;
    font-size: 0.98rem;
    margin-bottom: 12px;
    color: var(--ink);
    line-height: 1.5;
  }
  .qz-q-title .num {
    color: var(--cinnabar);
    font-family: var(--font-serif);
    font-weight: 600;
    margin-right: 8px;
    font-size: 1.05em;
  }
  .qz-opts {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
  }
  .qz-opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .qz-opt span {
    display: block;
    text-align: center;
    padding: 9px 4px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--line);
    border-radius: 10px;
    cursor: pointer;
    color: var(--ink-soft);
    background: var(--paper, #fbfaf7);
    transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
  }
  .qz-opt span:hover {
    border-color: rgba(42, 107, 87, 0.5);
    color: var(--cinnabar);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -6px rgba(28, 38, 34, 0.18);
  }
  .qz-opt input:checked + span {
    background: linear-gradient(180deg, #357e67, var(--cinnabar));
    border-color: var(--cinnabar);
    color: #fff;
    font-weight: 600;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px -6px rgba(42, 107, 87, 0.5);
  }
  .qz-opt input:checked + span:hover {
    color: #fff;
  }
  .qz-opt input:focus-visible + span {
    outline: 2px solid var(--cinnabar);
    outline-offset: 2px;
  }
  .qz-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 26px;
    gap: 12px;
  }
  .qz-btn {
    display: inline-block;
    padding: 12px 30px;
    border-radius: 999px;
    border: 1px solid var(--cinnabar);
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .qz-btn-primary {
    background: linear-gradient(180deg, #357e67, var(--cinnabar));
    color: #fff;
    box-shadow: 0 12px 28px -10px rgba(42, 107, 87, 0.45);
  }
  .qz-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -12px rgba(42, 107, 87, 0.5);
  }
  .qz-btn-ghost {
    background: transparent;
    color: var(--cinnabar);
  }
  .qz-btn-ghost:hover {
    background: rgba(42, 107, 87, 0.08);
    transform: translateY(-1px);
  }
  .qz-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
    filter: none;
    box-shadow: none;
  }
  .qz-hint {
    font-size: 0.8rem;
    color: var(--gold);
    margin-top: 12px;
    text-align: center;
    min-height: 1.2em;
    letter-spacing: 0.2em;
  }
  /* 结果页 */
  .qz-result-head {
    text-align: center;
    margin-bottom: 24px;
  }
  .qz-result-glyph {
    width: 96px;
    height: 96px;
    margin: 0 auto 18px;
    border-radius: 50%;
    border: 1px solid rgba(42, 107, 87, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 2.6rem;
    color: var(--cinnabar);
    background: radial-gradient(circle at 32% 28%, rgba(42, 107, 87, 0.14), rgba(42, 107, 87, 0.05)), #fff;
    box-shadow: 0 0 0 10px rgba(42, 107, 87, 0.05), 0 12px 28px -14px rgba(28, 38, 34, 0.25);
  }
  .qz-result-name {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .qz-result-tag {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin-top: 6px;
  }
  .qz-verdict-badge {
    display: inline-block;
    margin-top: 14px;
    padding: 5px 16px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }
  .qz-badge-primary {
    background: rgba(42, 157, 143, 0.12);
    color: #1f7a6e;
  }
  .qz-badge-warn {
    background: rgba(180, 98, 61, 0.1);
    color: #a05535;
  }
  .qz-result-desc {
    margin: 18px 0 6px;
    color: #2e3b35;
    line-height: 1.8;
  }
  .qz-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 22px;
  }
  @media (max-width: 640px) {
    .qz-cols {
      grid-template-columns: 1fr;
    }
    .qz-opts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .qz-cols h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .qz-cols ul {
    margin: 0;
    padding-left: 1.1em;
    line-height: 1.85;
    font-size: 0.92rem;
    color: #2e3b35;
  }
  .qz-tendencies {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .qz-tendencies h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .qz-tend-item {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 8px 0;
    font-size: 0.92rem;
  }
  .qz-tend-item .n {
    font-weight: 600;
    color: var(--ink);
    min-width: 150px;
  }
  .qz-tend-item .v {
    color: var(--cinnabar);
    font-size: 0.8rem;
  }
  .qz-bars {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .qz-bars h4 {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 16px;
  }
  .qz-bar-row {
    display: grid;
    grid-template-columns: 140px 1fr 44px;
    gap: 12px;
    align-items: center;
    margin-bottom: 10px;
    font-size: 0.85rem;
  }
  .qz-bar-row .label {
    color: var(--ink);
    text-align: right;
  }
  .qz-bar-row .label.main {
    color: var(--cinnabar);
    font-weight: 700;
  }
  .qz-bar-track {
    height: 12px;
    background: var(--paper-deep, #f1f0ea);
    border-radius: 999px;
    overflow: hidden;
  }
  .qz-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--cinnabar), #3e8e76);
    transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .qz-bar-fill.balanced {
    background: linear-gradient(90deg, #23857a, var(--jade));
  }
  .qz-bar-row .val {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .qz-disclaimer {
    margin-top: 26px;
    padding: 16px 20px;
    background: var(--paper-deep, #f1f0ea);
    border-radius: 12px;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.75;
  }
  .qz-restart {
    text-align: center;
    margin-top: 24px;
  }
</style>

<script define:vars={{ payload }}>
  (function () {
    const app = document.getElementById('quiz-app');
    if (!app) return;
    const D = JSON.parse(payload);
    const S = D.strings;
    const PER_PAGE = 5;
    const TOTAL_PAGES = Math.ceil(D.questions.length / PER_PAGE);
    const TYPE_KEYS = Object.keys(D.types);
    const answers = new Array(D.questions.length).fill(0);
    let phase = 'intro'; // intro | quiz | result
    let page = 0;

    function el(html) {
      const div = document.createElement('div');
      div.innerHTML = html.trim();
      return div.firstChild;
    }
    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function pageAnswered() {
      const start = page * PER_PAGE;
      for (let i = start; i < Math.min(start + PER_PAGE, D.questions.length); i++) {
        if (!answers[i]) return false;
      }
      return true;
    }
    function updateNextBtnState() {
      const btn = document.getElementById('qz-next');
      if (btn) btn.disabled = !pageAnswered();
      const hint = document.getElementById('qz-hint');
      if (hint) hint.textContent = pageAnswered() ? '' : '· · ·';
    }

    function renderIntro() {
      phase = 'intro';
      app.innerHTML = '';
      const card = el(
        '<div class="qz-card" style="text-align:center;">' +
          '<div style="display:flex;justify-content:center;gap:12px;margin-bottom:26px;flex-wrap:wrap;">' +
          TYPE_KEYS.map(function (k) {
            return (
              '<span style="width:46px;height:46px;border-radius:50%;border:1px solid rgba(42,107,87,0.22);display:flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:1.15rem;color:var(--cinnabar);background:radial-gradient(circle at 32% 28%, rgba(42,107,87,0.12), rgba(42,107,87,0.04));box-shadow:0 6px 16px -10px rgba(28,38,34,0.3);">' +
              D.types[k].glyph +
              '</span>'
            );
          }).join('') +
          '</div>' +
          '<button class="qz-btn qz-btn-primary" id="qz-start">' + esc(S.start) + '</button>' +
          '</div>'
      );
      card.querySelector('#qz-start').addEventListener('click', function () {
        page = 0;
        renderQuiz();
      });
      app.appendChild(card);
    }

    function renderQuiz() {
      phase = 'quiz';
      const start = page * PER_PAGE;
      const end = Math.min(start + PER_PAGE, D.questions.length);
      const progress = Math.round(((page + 1) / TOTAL_PAGES) * 100);

      let html = '<div class="qz-card">';
      html += '<div class="qz-progress"><div class="qz-progress-fill" style="width:' + progress + '%"></div></div>';
      html += '<div class="qz-progress-label"><span>' + esc(S.page) + ' ' + (page + 1) + ' ' + esc(S.of) + ' ' + TOTAL_PAGES + '</span><span>' + progress + '%</span></div>';
      for (let i = start; i < end; i++) {
        const q = D.questions[i];
        html += '<div class="qz-q">';
        html += '<div class="qz-q-title"><span class="num">' + (i + 1) + '.</span>' + esc(q.text) + '</div>';
        html += '<div class="qz-opts">';
        for (let v = 1; v <= 5; v++) {
          html +=
            '<label class="qz-opt"><input type="radio" name="q' + i + '" value="' + v + '"' +
            (answers[i] === v ? ' checked' : '') +
            '><span>' + esc(S.options[v - 1]) + '</span></label>';
        }
        html += '</div></div>';
      }
      html += '<div class="qz-nav">';
      html += page > 0
        ? '<button class="qz-btn qz-btn-ghost" id="qz-prev">' + esc(S.prev) + '</button>'
        : '<span></span>';
      html += page < TOTAL_PAGES - 1
        ? '<button class="qz-btn qz-btn-primary" id="qz-next" disabled>' + esc(S.next) + '</button>'
        : '<button class="qz-btn qz-btn-primary" id="qz-next" disabled>' + esc(S.submit) + '</button>';
      html += '</div>';
      html += '<div class="qz-hint" id="qz-hint"></div>';
      html += '</div>';

      app.innerHTML = '';
      app.appendChild(el(html));

      app.querySelectorAll('input[type="radio"]').forEach(function (input) {
        input.addEventListener('change', function () {
          answers[Number(input.name.slice(1))] = Number(input.value);
          updateNextBtnState();
        });
      });
      const prevBtn = document.getElementById('qz-prev');
      if (prevBtn) prevBtn.addEventListener('click', function () { page--; renderQuiz(); });
      document.getElementById('qz-next').addEventListener('click', function () {
        if (!pageAnswered()) return;
        if (page < TOTAL_PAGES - 1) { page++; renderQuiz(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
        else renderResult();
      });
      updateNextBtnState();
    }

    function computeScores() {
      const raw = {};
      const count = {};
      TYPE_KEYS.forEach(function (k) { raw[k] = 0; count[k] = 0; });
      D.questions.forEach(function (q, i) {
        raw[q.t] += answers[i];
        count[q.t] += 1;
      });
      // 转化分 = (原始分 - 条目数) / (条目数 × 4) × 100
      const conv = {};
      TYPE_KEYS.forEach(function (k) {
        conv[k] = Math.round(((raw[k] - count[k]) / (count[k] * 4)) * 100);
      });
      return { raw: raw, conv: conv };
    }

    function verdicts(conv) {
      const r = D.rules;
      const biased = TYPE_KEYS.filter(function (k) { return k !== 'pinghe'; });
      const othersMax = Math.max.apply(null, biased.map(function (k) { return conv[k]; }));
      let balanced = null;
      // 平和质：转化分 ≥60 且其他偏颇体质均 <30 判为"是"；均 <40 判为"基本是"
      if (conv.pinghe >= r.balancedYes && othersMax < r.biasedTendency) balanced = 'yes';
      else if (conv.pinghe >= r.balancedYes && othersMax < r.balancedMostly) balanced = 'mostly';
      const list = biased
        .map(function (k) {
          const v = conv[k] >= r.biasedYes ? 'yes' : conv[k] >= r.biasedTendency ? 'tendency' : 'no';
          return { key: k, score: conv[k], verdict: v };
        })
        .filter(function (x) { return x.verdict !== 'no'; })
        .sort(function (a, b) { return b.score - a.score; });
      return { balanced: balanced, list: list };
    }

    function typeCard(key, opts) {
      const T = D.types[key];
      let html = '<div class="qz-card">';
      html += '<div class="qz-result-head">';
      html += '<div class="qz-result-glyph">' + T.glyph + '</div>';
      html += '<div class="qz-result-name">' + esc(T.name) + '</div>';
      if (T.pinyin) html += '<div class="qz-result-tag">' + esc(T.pinyin) + ' · ' + esc(T.tagline) + '</div>';
      else html += '<div class="qz-result-tag">' + esc(T.tagline) + '</div>';
      if (opts.badge) html += '<span class="qz-verdict-badge ' + (opts.primary ? 'qz-badge-primary' : 'qz-badge-warn') + '">' + esc(opts.badge) + '</span>';
      html += '</div>';
      html += '<p class="qz-result-desc">' + esc(T.desc) + '</p>';
      html += '<div class="qz-cols">';
      html += '<div><h4>' + esc(S.traitsLabel) + '</h4><ul>' + T.traits.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul></div>';
      html += '<div><h4>' + esc(S.adviceLabel) + '</h4><ul>' + T.advice.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul></div>';
      html += '</div>';
      html += '</div>';
      return html;
    }

    function renderResult() {
      phase = 'result';
      const { conv } = computeScores();
      const v = verdicts(conv);
      let mainKey = null;
      let badge = '';
      let primary = false;
      if (v.balanced === 'yes') { mainKey = 'pinghe'; badge = S.balancedYes; primary = true; }
      else if (v.balanced === 'mostly') { mainKey = 'pinghe'; badge = S.balancedMostly; primary = true; }
      else if (v.list.length) { mainKey = v.list[0].key; badge = v.list[0].verdict === 'yes' ? S.verdictYes : S.verdictTendency; }
      else {
        // 未达到任何判定阈值时，展示得分最高的偏颇体质作为参考
        const top = TYPE_KEYS.slice().sort(function (a, b) { return conv[b] - conv[a]; }).filter(function (k) { return k !== 'pinghe'; });
        mainKey = top[0];
      }

      let html = '<h2 style="text-align:center;font-family:var(--font-serif);font-weight:550;letter-spacing:-0.015em;margin:0 0 26px;">' + esc(S.results) + '</h2>';
      if (mainKey) {
        html += typeCard(mainKey, { primary: primary, badge: badge });
        // 倾向列表（除主体质外）
        const tend = v.list.filter(function (x) { return x.key !== mainKey; });
        if (tend.length) {
          html += '<div class="qz-tendencies"><h4>' + esc(S.tendency) + '</h4>';
          tend.forEach(function (x) {
            html += '<div class="qz-tend-item"><span class="n">' + D.types[x.key].glyph + ' ' + esc(D.types[x.key].name) + '</span><span class="v">' + esc(x.verdict === 'yes' ? S.verdictYes : S.verdictTendency) + ' · ' + x.score + '</span></div>';
          });
          html += '</div>';
        }
      } else {
        html += '<div class="qz-card" style="text-align:center;">' + esc(S.results) + '</div>';
      }

      // 全部得分条形图
      const order = TYPE_KEYS.slice().sort(function (a, b) { return conv[b] - conv[a]; });
      html += '<div class="qz-bars"><h4>' + esc(S.allScores) + '</h4>';
      order.forEach(function (k) {
        const cls = k === mainKey ? ' main' : '';
        const fillCls = k === 'pinghe' || (k === mainKey && primary) ? ' balanced' : '';
        html += '<div class="qz-bar-row"><span class="label' + cls + '">' + esc(D.types[k].name) + '</span><div class="qz-bar-track"><div class="qz-bar-fill' + fillCls + '" style="width:' + Math.max(conv[k], 0) + '%"></div></div><span class="val">' + conv[k] + '</span></div>';
      });
      html += '</div>';

      html += '<div class="qz-disclaimer">' + esc(S.disclaimer) + '</div>';
      html += '<div class="qz-restart"><button class="qz-btn qz-btn-ghost" id="qz-retake">' + esc(S.retake) + '</button></div>';

      app.innerHTML = '';
      app.appendChild(el('<div>' + html + '</div>'));
      document.getElementById('qz-retake').addEventListener('click', function () {
        answers.fill(0);
        renderIntro();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    renderIntro();
  })();
</script>
