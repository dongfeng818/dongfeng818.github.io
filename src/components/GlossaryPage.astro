---
import { ui } from '../i18n/ui.js';
import { glossary } from '../data/glossary.js';

const { locale = 'en' } = Astro.props;
const t = ui[locale] ?? ui.en;
const terms = glossary[locale] ?? glossary.en;
---

<section class="section" style="padding-top: 80px;">
  <div class="container">
    <div class="section-head">
      <p class="kicker">{t.basicsKicker}</p>
      <h1 class="page-title">{t.glossaryTitle}</h1>
      <p class="page-lead">{t.glossaryLead}</p>
    </div>
    <div style="overflow-x: auto;">
      <table class="glossary-table">
        <thead>
          <tr>
            <th>{t.colTerm}</th>
            <th>{t.colChinese}</th>
            <th>{t.colPinyin}</th>
            <th>{t.colMeaning}</th>
          </tr>
        </thead>
        <tbody>
          {terms.map((it) => (
            <tr>
              <td><strong>{it.term}</strong></td>
              <td class="zh">{it.zh}</td>
              <td class="pinyin">{it.pinyin}</td>
              <td>{it.meaning}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
